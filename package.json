{
  "name": "athena",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "node scripts/buildAthenaWorker.mjs",
    "build:all": "npm run build && npm run build:worker",
    "start": "next start",
    "worker:dev": "node --import tsx workers/athenaWorker.ts",
    "worker:start": "node dist/worker/athenaWorker.js",
    "lint": "eslint",
    "test:worker": "node --import tsx --test tests/generationJobs/*.test.ts tests/executiveVersions/*.test.ts tests/prospects/*.test.ts tests/identity/*.test.ts tests/websiteLearning/*.test.ts",
    "test:conversation": "node --import tsx --test tests/prospects/prospectConversationService.test.ts tests/prospects/prospectConversationUi.test.ts tests/identityConversation/*.test.ts tests/gettingStartedConversation/*.test.ts"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.0",
    "cheerio": "^1.2.0",
    "crawlee": "^3.17.0",
    "date-holidays": "^3.35.0",
    "esbuild": "^0.25.0",
    "jsdom": "^29.1.1",
    "next": "16.2.10",
    "playwright": "^1.61.1",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/jsdom": "^28.0.3",
    "@types/mozilla__readability": "^0.4.2",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.19.0",
    "typescript": "^5"
  }
}
